# Install as /etc/isthereconsensus/api.env with mode 0600.
# Blank credentials are intentional: production startup must fail closed until
# the host secret store provides unique values.

SESSION_SECRET=
CAPTCHA_SECRET=
PUBLIC_SITE_URL=https://isthereconsensus.org
TRUST_PROXY_IPS=127.0.0.1,::1
CROSS_SITE=false
CORS_ORIGIN=
ALLOW_PUBLIC_LISTENER=false

# Choose one MongoDB source. Complete Vault credentials take precedence and a
# configured Vault failure never falls back to MONGODB_URI.
MONGODB_URI=
VAULT_ADDR=https://vault.example.net
VAULT_ROLE_ID=
VAULT_SECRET_ID=

ENABLE_INTERNAL_DIAGNOSTICS=false
INTERNAL_DIAGNOSTICS_KEY=
ENABLE_TOPIC_CREATION=false
SEED_CONTENT_MODE=insert

# Optional evidence provider metadata.
OPENALEX_EMAIL=
OPENALEX_API_KEY=
