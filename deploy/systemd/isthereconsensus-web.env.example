# Install as /etc/isthereconsensus/web.env with mode 0600.
NUXT_PUBLIC_SITE_URL=https://isthereconsensus.org
NUXT_PUBLIC_API_BASE=/api
NUXT_API_INTERNAL_BASE=http://127.0.0.1:3011
NUXT_PUBLIC_CAPTCHA_SITE_KEY=

# Frontend diagnostics remain disabled. If explicitly enabled, use a unique
# server-only key matching the protected backend diagnostics key.
ENABLE_INTERNAL_DIAGNOSTICS=false
NUXT_INTERNAL_DIAGNOSTICS_KEY=
