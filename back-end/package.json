{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "node --test --import tsx test/*.test.ts",
		"start": "node dist/server.js",
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"up": "taze major -I",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"create-admin": "node dist/create-admin-user.js",
		"create-admin-ts": "tsx -r dotenv/config src/create-admin-user.ts",
		"set-admin-status": "node dist/set-admin-status.js",
		"set-admin-status-ts": "tsx -r dotenv/config src/set-admin-status.ts",
		"migrate:evidence-landscape:v1": "tsx -r dotenv/config src/scripts/migrations/backfillEvidenceLandscapeV1.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"argon2": "^0.45.1",
		"cookie-session": "^2.1.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.1",
		"helmet": "^8.3.0",
		"mongoose": "^9.9.1",
		"readline-sync": "^1.4.10",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@types/cookie-session": "^2.0.49",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/readline-sync": "^1.4.8",
		"tsx": "^4.23.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"overrides": {
		"brace-expansion": "5.0.8",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"qs": "6.15.3",
		"vite": "8.1.5"
	}
}
