# EXAMPLE .env
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OR
# openssl rand -base64 64
#MONGODB_URI="mongodb://appuser:secretpassword@localhost:27017/DB_NAME_HERE?authSource=admin"
MONGODB_URI="mongodb://localhost:27017/DB_NAME_HERE"
SESSION_SECRET="SECRET_VALUE_HERE" # Like af8fb3d9d324792a867420f985cdf1b16e91dd086d5852e355c3922e05858a51
HOST=127.0.0.1
PORT=3011
TRUST_PROXY_IPS=loopback

PUBLIC_SITE_URL="https://isthereconsensus.org"
PUBLIC_API_BASE="/api"
INTERNAL_API_BASE="http://127.0.0.1:3011"
INTERNAL_DIAGNOSTICS_KEY="SECRET_VALUE_HERE"
ENABLE_INTERNAL_DIAGNOSTICS=false
CORS_ORIGIN=
CROSS_SITE=false
ENABLE_TOPIC_CREATION=false
# "insert" adds missing source-controlled claims without changing existing records.
# Use "sync" only for a reviewed, backup-protected content promotion, then return to "insert".
SEED_CONTENT_MODE=insert
CAPTCHA_SECRET=
PUBLIC_CAPTCHA_SITEKEY=
OPENALEX_EMAIL=
OPENALEX_API_KEY=

VAULT_ADDR=http://127.0.0.1:8200
# Set both AppRole values only when using Vault; otherwise leave both empty.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
