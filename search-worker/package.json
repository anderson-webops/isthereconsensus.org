{
	"name": "search-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@12.2.3",
	"engines": {
		"node": ">=26.13.1 <27",
		"npm": ">=11.19.0 <13"
	},
	"main": "dist/search-worker/src/server.js",
	"scripts": {
		"build": "rm -rf dist && node ../back-end/scripts/run-native-typescript.mjs -p tsconfig.json",
		"start": "node dist/search-worker/src/server.js",
		"lint": "eslint \"{src,test}/**/*.{ts,mjs}\"",
		"typecheck": "node ../back-end/scripts/run-native-typescript.mjs --noEmit -p tsconfig.eslint.json",
		"test": "node --test --import tsx test/*.test.ts"
	},
	"dependencies": {
		"@huggingface/tokenizers": "0.2.0",
		"onnxruntime-node": "1.31.1",
		"onnxruntime-web": "1.31.1",
		"wink-eng-lite-web-model": "1.8.1",
		"wink-nlp": "2.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "26.6.11",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@7.0.2"
	}
}
