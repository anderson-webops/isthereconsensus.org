# Nuxt server runtime settings. Copy these names into the protected
# /etc/isthereconsensus/web.env file; do not reuse or load back-end/.env.
NODE_ENV=production
NUXT_API_INTERNAL_BASE=http://127.0.0.1:3011
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_SITE_URL=https://isthereconsensus.org
NUXT_PUBLIC_CAPTCHA_SITE_KEY=

# Keep diagnostics disabled unless an operator explicitly needs them.
# When enabled, this server-only value must match the backend key.
ENABLE_INTERNAL_DIAGNOSTICS=false
NUXT_INTERNAL_DIAGNOSTICS_KEY=
