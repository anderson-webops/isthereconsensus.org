{
	"name": "front-end",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "rm -rf dist && nuxt build && node ./scripts/write-public-metadata.mjs && rm -rf dist && mkdir -p dist && rsync -a .output/public/ dist/",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"prepare": "nuxt prepare",
		"preview": "node ./scripts/preview.mjs",
		"_serve": "PORT=${PORT:-3000} node ./scripts/preview.mjs --port ${PORT:-3000} -o",
		"serve": "nuxt dev --open --host",
		"start": "node .output/server/index.mjs",
		"lint": "eslint .",
		"lint-fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"test:unit": "node --test --import tsx test/*.test.ts",
		"up": "taze major -I"
	},
	"dependencies": {
		"@vueuse/core": "^15.0.0",
		"pinia": "^4.1.0",
		"vue": "^3.5.44"
	},
	"optionalDependencies": {
		"@esbuild/linux-arm64": "0.28.2",
		"@esbuild/linux-x64": "0.28.2",
		"@oxc-parser/binding-linux-arm64-gnu": "0.156.0",
		"@oxc-parser/binding-linux-arm64-musl": "0.156.0",
		"@oxc-parser/binding-linux-x64-gnu": "0.156.0",
		"@oxc-parser/binding-linux-x64-musl": "0.156.0",
		"@oxfmt/binding-linux-arm64-gnu": "0.75.0",
		"@oxfmt/binding-linux-arm64-musl": "0.75.0",
		"@oxfmt/binding-linux-x64-gnu": "0.75.0",
		"@oxfmt/binding-linux-x64-musl": "0.75.0",
		"@rolldown/binding-linux-arm64-gnu": "1.2.15",
		"@rolldown/binding-linux-arm64-musl": "1.2.15",
		"@rolldown/binding-linux-x64-gnu": "1.2.15",
		"@rolldown/binding-linux-x64-musl": "1.2.15",
		"@rollup/rollup-linux-arm64-gnu": "4.66.0",
		"@rollup/rollup-linux-arm64-musl": "4.66.0",
		"@rollup/rollup-linux-x64-gnu": "4.66.0",
		"@rollup/rollup-linux-x64-musl": "4.66.0",
		"@unrs/resolver-binding-linux-arm64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-arm64-musl": "1.12.2",
		"@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-x64-musl": "1.12.2",
		"lightningcss-linux-arm64-gnu": "1.33.0",
		"lightningcss-linux-arm64-musl": "1.33.0",
		"lightningcss-linux-x64-gnu": "1.33.0",
		"lightningcss-linux-x64-musl": "1.33.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@iconify-json/carbon": "^1.2.29",
		"@iconify-json/twemoji": "^1.2.5",
		"@nuxt/eslint": "^1.17.0",
		"@nuxtjs/color-mode": "^4.1.0",
		"@pinia/nuxt": "^1.0.3",
		"@unocss/eslint-config": "^66.12.0",
		"@unocss/nuxt": "^66.12.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vueuse/nuxt": "^15.0.0",
		"eslint": "^10.13.0",
		"eslint-plugin-format": "^2.0.1",
		"nuxt": "^4.6.3",
		"terser": "^5.51.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unocss": "^66.12.0",
		"unplugin": "^3.7.0",
		"vite": "^8.3.5",
		"vue-tsc": "^3.3.13"
	},
	"overrides": {
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/kit": "^4.4.2",
		"nuxt": "$nuxt",
		"unplugin": "$unplugin",
		"vite": "$vite"
	}
}
