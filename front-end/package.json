{
	"name": "front-end",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "rm -rf dist && nuxt build && node ./scripts/write-public-metadata.mjs && rm -rf dist && mkdir -p dist && rsync -a .output/public/ dist/",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"prepare": "nuxt prepare",
		"preview": "node ./scripts/preview.mjs",
		"_serve": "PORT=${PORT:-3000} node ./scripts/preview.mjs --port ${PORT:-3000} -o",
		"serve": "nuxt dev --open --host",
		"start": "node .output/server/index.mjs",
		"lint": "eslint .",
		"lint-fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"test:unit": "node --test --import tsx test/*.test.ts",
		"up": "taze major -I"
	},
	"dependencies": {
		"@vueuse/core": "^14.4.0",
		"pinia": "^4.0.2",
		"vue": "^3.5.40"
	},
	"optionalDependencies": {
		"@esbuild/linux-arm64": "0.28.1",
		"@esbuild/linux-x64": "0.28.1",
		"@oxc-parser/binding-linux-arm64-gnu": "0.140.0",
		"@oxc-parser/binding-linux-arm64-musl": "0.140.0",
		"@oxc-parser/binding-linux-x64-gnu": "0.140.0",
		"@oxc-parser/binding-linux-x64-musl": "0.140.0",
		"@oxfmt/binding-linux-arm64-gnu": "0.35.0",
		"@oxfmt/binding-linux-arm64-musl": "0.35.0",
		"@oxfmt/binding-linux-x64-gnu": "0.35.0",
		"@oxfmt/binding-linux-x64-musl": "0.35.0",
		"@rolldown/binding-linux-arm64-gnu": "1.2.1",
		"@rolldown/binding-linux-arm64-musl": "1.2.1",
		"@rolldown/binding-linux-x64-gnu": "1.2.1",
		"@rolldown/binding-linux-x64-musl": "1.2.1",
		"@rollup/rollup-linux-arm64-gnu": "4.62.4",
		"@rollup/rollup-linux-arm64-musl": "4.62.4",
		"@rollup/rollup-linux-x64-gnu": "4.62.4",
		"@rollup/rollup-linux-x64-musl": "4.62.4",
		"@unrs/resolver-binding-linux-arm64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-arm64-musl": "1.12.2",
		"@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
		"@unrs/resolver-binding-linux-x64-musl": "1.12.2",
		"lightningcss-linux-arm64-gnu": "1.33.0",
		"lightningcss-linux-arm64-musl": "1.33.0",
		"lightningcss-linux-x64-gnu": "1.33.0",
		"lightningcss-linux-x64-musl": "1.33.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.3.0",
		"@iconify-json/carbon": "^1.2.25",
		"@iconify-json/twemoji": "^1.2.5",
		"@nuxt/eslint": "^1.17.0",
		"@nuxtjs/color-mode": "^4.0.0",
		"@pinia/nuxt": "^1.0.1",
		"@unocss/eslint-config": "^66.7.5",
		"@unocss/nuxt": "^66.7.5",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vueuse/nuxt": "^14.4.0",
		"eslint": "^10.8.0",
		"eslint-plugin-format": "^2.0.1",
		"nuxt": "^4.5.2",
		"terser": "^5.49.2",
		"tsx": "^4.23.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"unocss": "^66.7.5",
		"unplugin": "^3.3.0",
		"vite": "^8.2.1",
		"vue-tsc": "^3.3.9"
	},
	"overrides": {
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/kit": "^4.4.2",
		"nuxt": "^4.4.2",
		"unplugin": "^3.0.0",
		"vite": "^8.0.7"
	}
}
