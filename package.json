{
	"name": "isthereconsensus-monorepo",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=11.19.0 <13"
	},
	"description": "Monorepo for isthereconsensus.org",
	"author": "Jacob Anderson",
	"license": "ISC",
	"allowScripts": {
		"argon2@0.45.1": true,
		"esbuild@0.28.2": true,
		"express-rate-limit": false,
		"fsevents@2.3.3": true,
		"mongodb": false,
		"onnxruntime-node": false,
		"protobufjs": false,
		"puppeteer": false,
		"unrs-resolver@1.12.2": true
	},
	"workspaces": [
		"front-end",
		"back-end",
		"search-worker"
	],
	"scripts": {
		"build": "npm run -w front-end build && npm run -w back-end build && npm run -w search-worker build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run -w front-end lint && npm run -w back-end lint && npm run -w search-worker lint",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"test": "npm run -w front-end test:unit && npm run -w back-end test && npm run -w search-worker test && node --test scripts/test-braces-compat.mjs scripts/test-listhen-compat.mjs scripts/test-search-worker-artifact.mjs",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck && npm run -w search-worker typecheck",
		"smoke:live": "node scripts/live-site-smoke.mjs",
		"smoke:backend-runtime": "node scripts/backend-runtime-smoke.mjs",
		"smoke:ssr-assets": "node scripts/ssr-public-assets-smoke.mjs",
		"smoke:ssr-routes": "node scripts/ssr-route-rules-smoke.mjs",
		"artifact:build": "node scripts/build-runtime-artifact.mjs",
		"artifact:verify": "node scripts/verify-runtime-artifact.mjs .runtime-artifact",
		"artifact:smoke": "node scripts/runtime-artifact-smoke.mjs",
		"artifact:worker:build": "node scripts/build-search-worker-artifact.mjs",
		"artifact:worker:verify": "node scripts/verify-search-worker-artifact.mjs .search-worker-artifact",
		"artifact:worker:smoke": "node scripts/search-worker-artifact-smoke.mjs",
		"content:coverage": "npm exec -w back-end -- tsx src/scripts/reportContentCoverage.ts",
		"monitor:source-integrity": "npm run -w back-end monitor:source-integrity",
		"monitor:source-integrity-ts": "npm run -w back-end monitor:source-integrity-ts",
		"clean": "node scripts/clean.mjs",
		"verify:install-scripts": "node scripts/verify-install-script-policy.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"up": "node ./scripts/up.mjs",
		"a11y": "node scripts/a11y-smoke.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"@unocss/eslint-plugin": "^66.10.5",
		"axe-core": "^4.13.0",
		"braces": "file:vendor/braces",
		"cac": "^6.7.14",
		"commander": "^14.0.3",
		"esbuild": "0.28.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.12.0",
		"listhen": "file:vendor/listhen",
		"minimatch": "10.2.6",
		"mongoose": "^9.10.1",
		"oxc-parser": "0.151.0",
		"prettier": "^3.9.6",
		"puppeteer": "^25.11.0",
		"simple-git": "file:vendor/simple-git",
		"taze": "^21.1.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"unplugin": "^3.4.0"
	},
	"overrides": {
		"@bomb.sh/tab": "0.0.22",
		"@modelcontextprotocol/client": "2.2.0",
		"esbuild": "0.28.2",
		"vite": {
			"esbuild": "0.28.2"
		},
		"defu": "6.1.6",
		"devalue": "5.9.4",
		"glob": "13.0.6",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"minimatch": "$minimatch",
		"braces": "$braces",
		"listhen": "$listhen",
		"path-to-regexp": "8.4.2",
		"picomatch": "4.0.5",
		"qs": "6.16.0",
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"serialize-javascript": "7.0.5",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.16.0"
		},
		"nitropack": "2.13.4",
		"simple-git": {
			".": "$simple-git",
			"simple-git": "4.0.2"
		},
		"brace-expansion": "5.0.12",
		"fast-uri": "3.1.8",
		"js-yaml": "4.3.2",
		"katex": "0.18.2",
		"postcss": "8.5.26",
		"proxy-addr": "2.0.8",
		"shell-quote": "1.11.0",
		"source-map-js": "1.2.2",
		"svgo": "4.1.0",
		"tar": "7.5.22",
		"tinypool": "2.1.2",
		"valibot": "1.4.2"
	}
}
