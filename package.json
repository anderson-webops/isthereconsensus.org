{
	"name": "isthereconsensus-monorepo",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Monorepo for isthereconsensus.org",
	"author": "Jacob Anderson",
	"license": "ISC",
	"allowScripts": {
		"argon2@0.45.1": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": true,
		"unrs-resolver@1.12.2": true
	},
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"build": "npm run -w front-end build && npm run -w back-end build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run -w front-end lint && npm run -w back-end lint",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"test": "npm run -w front-end test:unit && npm run -w back-end test",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"smoke:live": "node scripts/live-site-smoke.mjs",
		"smoke:backend-runtime": "node scripts/backend-runtime-smoke.mjs",
		"smoke:ssr-assets": "node scripts/ssr-public-assets-smoke.mjs",
		"smoke:ssr-routes": "node scripts/ssr-route-rules-smoke.mjs",
		"clean": "node scripts/clean.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"up": "node ./scripts/up.mjs",
		"a11y": "node scripts/a11y-smoke.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@unocss/eslint-plugin": "^66.7.5",
		"axe-core": "^4.12.1",
		"esbuild": "0.28.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.6.0",
		"h3": "1.15.11",
		"minimatch": "10.2.6",
		"prettier": "^3.9.6",
		"puppeteer": "^25.4.0",
		"taze": "^19.16.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"vite": {
			"esbuild": "0.28.1"
		},
		"defu": "6.1.6",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"minimatch": "$minimatch",
		"node-forge": "1.4.0",
		"path-to-regexp": "8.4.0",
		"picomatch": "4.0.4",
		"qs": "6.15.3",
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"serialize-javascript": "7.0.5",
		"srvx": "0.11.13",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.3"
		},
		"nitropack": "2.13.4",
		"simple-git": "3.36.0",
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"tar": "7.5.22",
		"valibot": "1.4.2"
	},
	"dependencies": {
		"qs": "6.15.3"
	}
}
